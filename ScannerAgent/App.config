<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <!-- Nothing secret in here: the agent has no database access. -->
  <appSettings>
    <add key="Port"              value="8036" />
    <!-- Web applications allowed to use the scanner, comma separated, exactly as shown in the browser
         address bar (scheme://host[:port]), e.g. https://txn.company.local,http://hrapp:8080
         "*" = any site (only for testing). -->
    <add key="AllowedOrigins"    value="*" />
    <add key="MinQuality"        value="40" />
    <add key="MaxTimeoutSeconds" value="30" />
    <add key="BlinkCount"        value="3" />
    <add key="BlinkOnMs"         value="250" />
    <add key="BlinkOffMs"        value="250" />
    <add key="BlinkSettleMs"     value="700" />
  </appSettings>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
