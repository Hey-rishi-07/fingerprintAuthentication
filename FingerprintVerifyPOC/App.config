<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>

  <connectionStrings>
    <!-- Use a READ-ONLY Oracle user that only has SELECT on the view below. -->
    <add name="OracleDB"
         connectionString="User Id=FP_POC_RO;Password=change_me;Data Source=//DB_HOST:1521/SERVICE_NAME;Connection Timeout=10;" />
  </connectionStrings>

  <appSettings>
    <!-- ===== Where the enrolled fingerprints are read from (see Sql\Create_POC_View.sql) ===== -->
    <add key="FpSourceTable"    value="FP_AUTH_V" />        <!-- view or table, may be SCHEMA.NAME -->
    <add key="FpPcnoColumn"     value="PCNO" />
    <add key="FpTemplateColumn" value="FINGER_TEMPLATE" />
    <add key="FpFingerColumn"   value="FINGER_NO" />        <!-- optional (finger index / id), only for logs; empty = none -->

    <!-- ISO = ISO 19794-2 (MatchISO), ANSI = ANSI 378 (MatchANSI). Must be the format the main table was enrolled in. -->
    <add key="TemplateFormat"   value="ISO" />
    <!-- AUTO | RAW (BLOB/RAW bytes) | BASE64 | HEX (text in CLOB/VARCHAR2) -->
    <add key="TemplateEncoding" value="AUTO" />

    <!-- ===== Matching / capture ===== -->
    <add key="MatchThreshold"        value="1400" />  <!-- calibrate with the scores in logs\verify_*.csv -->
    <add key="CaptureTimeoutSeconds" value="10" />
    <add key="MinQuality"            value="40" />
    <add key="BlinkCount"            value="3" />     <!-- 0 = no blink, light just comes on -->
    <add key="BlinkOnMs"             value="250" />
    <add key="BlinkOffMs"            value="250" />
    <add key="PcnoPattern"           value="^[A-Za-z0-9_-]{1,30}$" />

    <!-- ===== Local web service ===== -->
    <add key="HttpPort"       value="8035" />
    <!-- "*" for the POC. Later: comma separated list of the transaction web app origin(s), e.g. https://txn.corp.local -->
    <add key="AllowedOrigins" value="*" />
    <add key="OpenBrowser"    value="true" />
    <add key="LogFolder"      value="logs" />
  </appSettings>
</configuration>
