<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>

  <connectionStrings>
    <!-- Oracle 11g R2 (11.2.0.4) or newer. The user needs SELECT on the view, and
         SELECT/INSERT/UPDATE/DELETE on FP_POC_ENROLL if the Enroll page / import is used. -->
    <add name="OracleDB"
         connectionString="User Id=FP_POC_RO;Password=change_me;Data Source=//DB_HOST:1521/SERVICE_NAME;Connection Timeout=10;" />
  </connectionStrings>

  <appSettings>
    <!-- ===== Where VERIFY reads enrolled fingerprints from =====
         FP_AUTH_V     = view over the main fingerprint table (Sql\Create_POC_View.sql)
         FP_POC_ENROLL = the POC's own table, filled by the Enroll page or by import (Sql\Create_POC_Enroll_Table.sql) -->
    <add key="FpSourceTable"    value="FP_AUTH_V" />        <!-- view or table, may be SCHEMA.NAME -->
    <add key="FpPcnoColumn"     value="PCNO" />
    <add key="FpTemplateColumn" value="FINGER_TEMPLATE" />
    <add key="FpFingerColumn"   value="FINGER_NO" />        <!-- optional (finger index / id), only for logs; empty = none -->

    <!-- AUTO = try MatchISO and MatchANSI and keep the best score. ISO / ANSI = only that one (once you know). -->
    <add key="TemplateFormat"   value="AUTO" />
    <!-- AUTO | RAW (BLOB/RAW bytes) | BASE64 | HEX (text in CLOB/VARCHAR2) -->
    <add key="TemplateEncoding" value="AUTO" />

    <!-- ===== Matching / capture ===== -->
    <add key="MatchThreshold"        value="1400" />  <!-- calibrate with the scores in logs\verify_*.csv -->
    <add key="CaptureTimeoutSeconds" value="10" />
    <add key="MinQuality"            value="40" />
    <add key="BlinkCount"            value="3" />     <!-- 0 = no blink, light just comes on -->
    <add key="BlinkOnMs"             value="250" />
    <add key="BlinkOffMs"            value="250" />
    <add key="BlinkSettleMs"         value="700" />   <!-- pause after the blink so the sensor is stable before the real capture -->
    <add key="PcnoPattern"           value="^[A-Za-z0-9_-]{1,30}$" />

    <!-- ===== POC enrolment table: Enroll page /enroll, run_enroll_console.bat, import_existing.bat ===== -->
    <add key="EnrollEnabled"    value="true" />
    <add key="EnrollTable"      value="FP_POC_ENROLL" />
    <add key="EnrollMinQuality" value="60" />
    <!-- import (import_existing.bat) copies from this view/table into EnrollTable -->
    <add key="ImportSourceTable"    value="FP_AUTH_V" />
    <add key="ImportPcnoColumn"     value="PCNO" />
    <add key="ImportTemplateColumn" value="FINGER_TEMPLATE" />
    <add key="ImportFingerColumn"   value="FINGER_NO" />     <!-- empty = number each PC No's rows 1,2,3... -->

    <!-- ===== Local web service ===== -->
    <add key="HttpPort"       value="8035" />
    <!-- "*" for the POC. Later: comma separated list of the transaction web app origin(s), e.g. https://txn.corp.local -->
    <add key="AllowedOrigins" value="*" />
    <add key="OpenBrowser"    value="true" />
    <add key="LogFolder"      value="logs" />
  </appSettings>

  <runtime>
    <!-- Allows loading MANTRA.MFS100.dll when the files came from a downloaded zip or a network share
         (otherwise: "An attempt was made to load an assembly from a network location ...") -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
